# ==============================================================================
# NetMind AI - Environment Configuration Template
# ==============================================================================

# Application Environment (development, staging, production)
NETMIND_ENV=development
LOG_LEVEL=INFO

# PostgreSQL / TimescaleDB Database Configuration
POSTGRES_USER=netmind_admin
POSTGRES_PASSWORD=netmind_secure_password
POSTGRES_DB=netmind_telemetry
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Network Ingestion Paths
ZEEK_LOG_DIR=netmind/logs/
SURICATA_EVE_PATH=netmind/logs/eve.json
RAW_DATA_DIR=netmind/data/raw/
PROCESSED_DATA_DIR=netmind/data/processed/

# Feature Engineering & Model Artifacts
FEATURE_STORE_PATH=netmind/data/processed/features.parquet
MODEL_DIR=netmind/models/
EPSILON=1e-6

# API Service
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
